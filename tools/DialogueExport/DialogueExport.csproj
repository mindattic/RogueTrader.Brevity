<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game paths and the shared blueprint reader come from RogueTrader.Shared, checked out next to this repo. -->
  <PropertyGroup>
    <RogueTraderShared Condition="'$(RogueTraderShared)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\RogueTrader.Shared')">$(MSBuildThisFileDirectory)..\..\..\RogueTrader.Shared</RogueTraderShared>
    <!-- From a worktree under <repo>\.worktrees\<name> the sibling checkout is two levels further up. -->
    <RogueTraderShared Condition="'$(RogueTraderShared)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..\RogueTrader.Shared</RogueTraderShared>
  </PropertyGroup>
  <Import Project="$(RogueTraderShared)\RogueTrader.Tools.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
