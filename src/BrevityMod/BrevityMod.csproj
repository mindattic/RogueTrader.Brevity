<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game paths and references, the shared runtime helpers and release packaging come from RogueTrader.Shared,
       checked out next to this repo. -->
  <PropertyGroup>
    <RogueTraderShared Condition="'$(RogueTraderShared)' == ''">$(MSBuildThisFileDirectory)..\..\..\RogueTrader.Shared</RogueTraderShared>
  </PropertyGroup>
  <Import Project="$(RogueTraderShared)\RogueTrader.Mod.props" />

  <PropertyGroup>
    <AssemblyName>RogueTraderBrevity</AssemblyName>
    <RootNamespace>RogueTraderBrevity</RootNamespace>
    <UmmDir Condition="'$(UmmDir)' == ''">$(GameDataDir)\UnityModManager</UmmDir>
    <ModFolderName>RogueTraderBrevity</ModFolderName>
    <ModInstallDir>$(UmmDir)\$(ModFolderName)</ModInstallDir>
    <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Info.json')), '"Version":\s*"([^"]+)"').Groups[1].Value)</ModVersion>
    <ShortText Condition="'$(ShortText)' == ''">$(MSBuildThisFileDirectory)..\..\.brevity\simplified.json</ShortText>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityModManager" HintPath="$(UmmDir)\UnityModManager.dll" Private="false" />
  </ItemGroup>

  <Target Name="InstallMod" AfterTargets="Build">
    <Error Condition="!Exists('$(ShortText)')" Text="No shortened text at $(ShortText); run DialogueSimplify --import first." />
    <Copy SourceFiles="$(TargetPath);Info.json;$(ShortText)" DestinationFolder="$(ModInstallDir)" />
    <Message Importance="high" Text="Installed to $(ModInstallDir)" />
  </Target>

  <!-- dotnet build -c Release also writes the Nexus/Vortex upload, dist\RogueTraderBrevity-<version>.zip holding a
       RogueTraderBrevity folder (RogueTrader.Package.targets). Only these files ship, not settings Unity Mod Manager
       writes into the install folder. -->
  <ItemGroup>
    <PackageFile Include="$(TargetPath);Info.json;$(ShortText)" />
  </ItemGroup>

</Project>
